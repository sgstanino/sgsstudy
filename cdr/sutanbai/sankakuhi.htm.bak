<HTML><HEAD>
<META http-equiv=Content-Type content="text/html; charset=UTF-8">

<SCRIPT language=JavaScript>
<!-- 
var i=0

function kaiten(){
	//半征E
	r = 100
	
	//値を計算（画面上ではYは下向きが正になってぁE���E�E
	//////////////////////////////////
	y= r * Math.sin(i*Math.PI/180);
	x= r * Math.cos(i*Math.PI/180);
	//////////////////////////////////

	//点のx座標に値をセチE��する
	document.all.ball.style.posTop =y
	//点のy座標に値をセチE��する
	document.all.ball.style.posLeft =x

	//角度の表示
	document.F1.Kakudo.value =i

	//画面更新間隔
	window.setTimeout("kaiten()", 100);

	//角度を増加させめE
	i=i+1;
	
}
-->
</SCRIPT>

</HEAD>

<BODY onload=kaiten()>
<FORM name=F1 action=#>角度は<INPUT size=10 name=Kakudo>
</FORM>
<SPAN id=hako style="LEFT: 200px; POSITION: absolute; TOP: 200px">
□
<SPAN id=ball style="POSITION: absolute">
◁E
</SPAN>
</SPAN>
<DIV style="LEFT: 400px; POSITION: absolute; TOP: 0px">
<A HREF="sankakuhi.EXE">ソースファイルダウンローチE/A>
</DIV>
</BODY>
</HTML>
