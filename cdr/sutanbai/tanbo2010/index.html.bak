<table align="center" class="main" summary="Thumbnail List">
</DIV>	<tr class="header">
		<td colspan="3">
			<div id="FILENAME" class="header">20100104.JPG</div>
		</td>
	</tr>
	<tr class="contents">
		<td class="contents_left"></td>
		<td>
			<table class="photo_contents" summary="20100104.JPG">
				<tr>
					<td align="center"><img id="SLIDESHOW" src="photo/20100104.JPG" alt="SlideShow"></td>
				</tr>
				<tr>
					<td><div id="COMMENT" class="slideshow_comment" align="center"><br></div>
				</tr>
			</table>
